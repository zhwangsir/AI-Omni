{
  "name": "omni_volume",
  "version": "0.1.0",
  "description": "系统音量控制插件 - macOS osascript 桥接，支持设置/查询/静音/取消静音",
  "author": "AI-Omni",
  "permissions": [
    "tools.register"
  ],
  "platforms": ["macos"],
  "dependencies": {
    "omni_sdk": ">=0.1.0"
  },
  "events": {
    "publishes": ["system.volume_changed"],
    "subscribes": []
  },
  "tools": [
    "system_set_volume",
    "system_get_volume",
    "system_mute",
    "system_unmute"
  ]
}
