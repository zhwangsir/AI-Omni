{
  "name": "omni_process",
  "version": "0.1.0",
  "description": "系统进程管理插件 - 列出/杀死/启动进程",
  "author": "AI-Omni",
  "permissions": ["tools.register"],
  "platforms": ["macos", "linux"],
  "dependencies": {
    "omni_sdk": ">=0.1.0"
  },
  "events": {
    "publishes": [
      "system.process_killed",
      "system.process_started"
    ],
    "subscribes": []
  },
  "tools": [
    "system_list_processes",
    "system_kill_process",
    "system_start_process"
  ]
}
