{
  "name": "omni_power",
  "version": "0.1.0",
  "description": "电源管理插件 - macOS 锁屏/睡眠/关机/重启，危险操作需二次确认",
  "author": "AI-Omni",
  "permissions": [
    "tools.register"
  ],
  "platforms": ["macos"],
  "dependencies": {
    "omni_sdk": ">=0.1.0"
  },
  "events": {
    "publishes": ["system.power_action"],
    "subscribes": []
  },
  "tools": [
    "system_lock_screen",
    "system_sleep",
    "system_shutdown",
    "system_restart"
  ]
}
